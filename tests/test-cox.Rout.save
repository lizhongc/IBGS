> library(IBGS)
> source("helper-sim.R")
> 
> # coxIBGS / coxGibbs run and have the right (intercept-free) structure
> set.seed(11)
> d  <- sim_cox()
> fi <- coxIBGS(d$time, d$status, d$x, criterion = "BIC",
+               block.size = 10, n.keep = 10, n.refine = 2, n.draws = 150)
> expect_ibgs(fi, ncol(d$x))
> stopifnot(fi$family == "cox")
> stopifnot(!fi$has.intercept)               # the Cox model has no intercept
> stopifnot(nrow(fi$coef) == ncol(d$x))      # so no intercept row
> 
> fg <- coxGibbs(d$time, d$status, d$x, criterion = "BIC", n.draws = 150)
> expect_ibgs(fg, ncol(d$x))
> expect_recovers(fg, d$truth)
> 
> pr <- predict(fg, d$x[1:5, ])              # relative risk exp(x beta)
> stopifnot(length(pr) == 5)
> stopifnot(all(pr > 0))
> stopifnot(length(fitted(fg)) == length(d$time))
> 
> # the final long run starts from the empty model, not the candidate set.  Under
> # heavy censoring the candidate set can reach the event count d, where the AICc
> # correction 2*npred*(npred+1)/(d - npred - 1) flips sign and a model saturated in
> # the events looks spuriously optimal; a full-candidate start got stuck there.
> set.seed(77)
> xx <- matrix(rnorm(60 * 60), 60, 60)
> tt <- rexp(60, exp(as.numeric(xx[, 1:2] %*% c(1.2, -1.2))))
> ss <- rbinom(60, 1, 0.35)                  # ~1/3 events, so d is well below n
> fa <- coxIBGS(tt, ss, xx, criterion = "AICc", n.refine = 2, n.keep = 20,
+               n.draws = 150)
> stopifnot(max(colSums(fa$coef != 0)) < sum(ss != 0) - 1,   # denominator stays > 0
+           ncol(fa$coef) > 1)                               # chain moved, not stuck
> 
> # cox samplers reject a status of the wrong length
> set.seed(12)
> d <- sim_cox()
> expect_err(coxGibbs(d$time, d$status[-1], d$x), "length")
> expect_err(coxIBGS(d$time, d$status[-1], d$x), "length")
> 
> proc.time()
   user  system elapsed 
 18.757   0.236  19.199 
